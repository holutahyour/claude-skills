{
  "description": "Gives Claude a standing challenge-idea rule at session start (and after compaction), and reminds it on each skill it loads, on each agent's findings, and inside every subagent. Reminders only; never blocks.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/challenge-idea-hook.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/challenge-idea-hook.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/challenge-idea-hook.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
